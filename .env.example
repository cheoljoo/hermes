# Copy this file to .env and fill in at least one LLM provider key.
# Full option list (other providers, Telegram/Discord/Slack gateways, terminal
# backends, browser tools, etc.) lives in upstream .env.example:
#   https://github.com/NousResearch/hermes-agent/blob/main/.env.example

# =============================================================================
# LLM PROVIDER (OpenRouter — simplest option, one key for many models)
# =============================================================================
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Pick/change the active model after the container is up, via:
#   docker compose exec gateway hermes model

# =============================================================================
# LLM PROVIDER (EXAONE — LGE AILab internal EXACODE SWE API)
# =============================================================================
# Custom provider plugin, see plugins/exaone/. Requires network access to
# exacode-chat.lge.com (internal).
EXAONE_API_KEY=
